# Copy to deploy/.env (never commit it) and fill in. docker compose reads it from deploy/.

# Which setup: one COMPOSE_FILE line (compose.yaml says what each file is for).
# Doorman alone; your agent joins the doorman-agent network:
COMPOSE_FILE=compose.yaml
# Plus network watch, with Hermes behind the proxy:
# COMPOSE_FILE=compose.yaml:compose.egress.yaml:compose.hermes.yaml
# Plus network watch, with your own agent (a copy of compose.hermes.yaml):
# COMPOSE_FILE=compose.yaml:compose.egress.yaml:compose.myagent.yaml
# Optional sidecars, either or both:
# COMPOSE_PROFILES=whatsapp,reader

# Doorman. Generate once and keep it in your password manager: it unlocks every stored credential.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOORMAN_VAULT_KEY=
ANTHROPIC_API_KEY=
# Where the owner app's port listens on the host. 127.0.0.1: only this machine, for the HTTPS in front of
# it. 0.0.0.0: your network too, for an app opened without HTTPS (docs/running.md, "Without HTTPS").
DOORMAN_OWNER_BIND=127.0.0.1

# Network watch (compose.egress.yaml): the proxy's token from More > Network > Set up the proxy, and the
# agent's key from More > Agents.
# DOORMAN_EGRESS_TOKEN=dme_...
# AGENT_DOORMAN_TOKEN=dmn_...
# The agent's image, pinned to a version you checked (the agent's compose file has a default):
# AGENT_IMAGE=nousresearch/hermes-agent:<version>
# Who the agent runs as: the image's own user (name or uid:gid), never root (compose.hermes.yaml: hermes):
# AGENT_USER=hermes
# The agent's home, where the decoy keys go (into its .config/secrets):
# AGENT_HOME=/opt/data
# No country table (no monthly download from download.db-ip.com):
# EGRESS_GEOIP=0
# Hermes (compose.hermes.yaml): its memory limit, and the Webapp's sign-in (profile webapp, on 127.0.0.1:9120):
# AGENT_MEM_LIMIT=4g
# COMPOSE_PROFILES=webapp
# HERMES_WEBAPP_USER=owner
# HERMES_WEBAPP_PASSWORD=          # openssl rand -hex 16

# WhatsApp sidecar (profile whatsapp): optional, a token of your own instead of the generated one.
# SIDECAR_TOKEN=

# Reader (profile reader, docs/reader-actor.md): its key and an OpenAI-compatible model API.
# READER_DOORMAN_TOKEN=dmn_...
# READER_API_BASE=https://<host>/v1
# READER_API_KEY=
# READER_MODEL=
